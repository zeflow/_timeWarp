# === Download from Splunk REST API (import_data.py)
SPLUNK_BASE_URL=https://your-splunk-host:8089        # Splunk management port (8089) for REST searches
SPLUNK_USERNAME=your-username                        # Splunk user with search privileges
SPLUNK_PASSWORD=your-password                        # Password for the Splunk user
SPLUNK_SEARCH=index=notable                          # time bounds are injected by import_data.py
SPLUNK_FIELDS=_time host source sourcetype _raw         # optional field list appended by import_data.py
SPLUNK_EXPORT_DIR=export_bots_data4                  # Where downloaded JSONL windows are written
SPLUNK_EARLIEST=2020-07-18T00:00:00                  # ISO timestamp for start of export window
SPLUNK_LATEST=2020-09-29T00:00:00                    # ISO timestamp for end of export window
SPLUNK_STEP_HOURS=1                                  # Window size in hours between earliest/latest

# === Time-shift exported data (shift_timestamps.py)
SHIFT_INPUT_GLOB=export_bots_data4/*.jsonl           # Source files to time-shift
SHIFT_OUTPUT_DIR=shifted                             # Destination folder for shifted files
SHIFT_TARGET_EARLIEST_ISO=2024-01-01T00:00:00Z       # Optional ISO timestamp to pin earliest event to (leave empty to use NOW minus days)
SHIFT_TARGET_LATEST_ISO=2024-01-31T23:59:59Z         # Optional ISO timestamp to pin latest event to (overrides earliest if mode=latest)
SHIFT_TARGET_EARLIEST_NOW_MINUS_DAYS=0               # Used when SHIFT_TARGET_EARLIEST_ISO is empty
SHIFT_TARGET_LATEST_NOW_MINUS_DAYS=7                 # If mode=latest and latest ISO empty, use now minus N days (0 disables)
SHIFT_AGGRESSIVE_RAW_REWRITE=true                   # true to rewrite more raw timestamp-like fields
SHIFT_MODE=iso                                       # iso | days | latest

# === Scan sourcetypes and time ranges (scan_sourcetypes_and_dates.py)
SCAN_INPUT_GLOB=export_bots_data4/*.jsonl            # Files to scan for sourcetypes/time ranges

# === Upload via HEC (upload_data_hec.py)
SPLUNK_HEC_BASE_URL=https://your-splunk-hec-host:8088  # HEC endpoint (usually 8088)
SPLUNK_HEC_TOKEN=your-hec-token                         # HEC token with ingest privileges
HEC_INPUT_GLOB=shifted/*.jsonl                          # Files to upload into HEC
